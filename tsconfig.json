{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "allowJs": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types"]
  },
  "kvNamespaces": ["KV"],
  "d1Databases": ["DB"]
}